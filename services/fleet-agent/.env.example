# Environment variables services/fleet-agent understands.
#
# Nothing reads this file automatically -- it lists the names. Set them in
# your shell before running, e.g. PowerShell:
#     $env:ANTHROPIC_API_KEY = "sk-ant-..."
# A real `.env` file is gitignored; never commit a key.

# Optional. When set, operator requests are interpreted by Claude
# (app/mission/goal_parser.py). When unset, the rule-based parser is used.
# Either way, deterministic code plans and safety-checks the mission.
# Also requires: pip install anthropic
ANTHROPIC_API_KEY=
