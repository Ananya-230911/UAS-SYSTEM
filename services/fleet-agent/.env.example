# Environment variables services/fleet-agent understands.
#
# Nothing reads this file automatically -- it lists the names. Set them in
# your shell before starting the server, e.g. PowerShell:
#     $env:GROQ_API_KEY = "gsk_..."
# A real `.env` file is gitignored; never commit a key.
#
# Without any key, everything still works: the built-in rules interpret
# instructions, and planning + safety checks never use an AI anyway.

# Optional, preferred. Groq interprets operator text: the "Tell the drones"
# box (app/supervisor/instructions.py) and goal text (app/mission/goal_parser.py).
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Which Groq model to use. Default: openai/gpt-oss-20b. Groq
# retires models from time to time -- check https://console.groq.com/docs/models
GROQ_MODEL=

# Optional. Used for goal text only if no GROQ_API_KEY is set.
# Also requires: pip install anthropic
ANTHROPIC_API_KEY=

# Optional. Where the perception service (YOLOv8) runs, for the quick
# survey's camera results. Default: http://localhost:8010. If nothing
# answers there, the camera results are labelled made-up counts.
PERCEPTION_URL=
